# Copiar este archivo a functions/.env y completar con los valores reales.
# functions/.env NO se commitea (ver functions/.gitignore) — Firebase CLI lo
# carga solo a process.env al emular/deployar, no hace falta functions:config:set.
#
# Generar el par de llaves con:
#   cd functions && npx web-push generate-vapid-keys

VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_EMAIL=mailto:admin@navimag.cl

# Secreto para el endpoint sendManualPush — cualquier string largo y único.
PUSH_SECRET=
